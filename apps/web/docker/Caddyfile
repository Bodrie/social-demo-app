# Serves the built web app and proxies the API on one origin. TLS terminates at the
# Cloudflare edge (tunnel), so this listens on plain HTTP inside the compose network.
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	# Uploaded pictures straight from the shared volume: no Node in the path.
	handle_path /api/v1/uploads/* {
		root * /srv/uploads
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# API and realtime. The client address comes from Cloudflare's header when present;
	# the API trusts exactly this hop (TRUST_PROXY=1).
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			header_up X-Forwarded-For {header.CF-Connecting-IP}
		}
	}
	handle /socket.io/* {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			header_up X-Forwarded-For {header.CF-Connecting-IP}
		}
	}

	# Hashed build assets: cached forever. One that does not exist (a chunk of an older build
	# after a deploy) is a plain 404 that nobody caches, never index.html.
	handle /assets/* {
		root * /srv/www
		@found file
		@missing not file
		header @found Cache-Control "public, max-age=31536000, immutable"
		header @missing Cache-Control "no-store"
		header X-Content-Type-Options nosniff
		file_server
	}

	# The single-page app: every other path is a file from the build or index.html, and both
	# are revalidated on every load, so a deploy is picked up at once. Matched on the request,
	# not on the file served: `header /index.html` would never see a navigation to `/u/alice`.
	handle {
		root * /srv/www
		header Cache-Control "no-cache"
		header X-Content-Type-Options nosniff
		header Referrer-Policy strict-origin-when-cross-origin
		try_files {path} /index.html
		file_server
	}
}
