# Base URL of the API as seen from the browser. Empty = same origin (Vite dev proxy / Caddy in production).
VITE_API_URL=
# Where the Vite dev server proxies /api and /socket.io to.
VITE_DEV_API_URL=http://localhost:3000
# Shown on /privacy and /terms (baked in at build time; pass them as docker build args in production).
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=
VITE_REPOSITORY_URL=https://github.com/Bodrie/social-demo-app
# Cloudflare Turnstile site key (build-time). Set → the register form shows the bot check and the
# API needs the matching TURNSTILE_SECRET. Empty (development, tests) → no widget.
VITE_TURNSTILE_SITE_KEY=
