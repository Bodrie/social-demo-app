// The Mesh – data model. Rationale: docs/REBUILD_PLAN.md §2.3, docs/adr/0002.
// Conventions: UUID v7 ids, snake_case tables/columns, timestamptz in UTC,
// relation tables instead of denormalised columns.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // relationJoins compiles `_count` and filtered relation selects into LATERAL
  // joins instead of whole-table GROUP BY subqueries (see docs/REBUILD_PLAN.md review notes).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  username        String    @unique
  passwordHash    String    @map("password_hash")
  /// Set once the address was confirmed through a mailed link; the app is closed until then.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// When the "confirm or the account is removed" mail went out (JobsService); unverified accounts only.
  expiryWarnedAt  DateTime? @map("expiry_warned_at") @db.Timestamptz(3)
  name            String
  bio             String?
  city            String?
  website         String?
  avatarKey       String?   @map("avatar_key")
  coverKey        String?   @map("cover_key")
  /// Account-level preferences (`userSettingsSchema` in shared); keys are added as features land.
  settings        Json      @default("{}") @db.JsonB
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  posts            Post[]
  comments         Comment[]
  postLikes        PostLike[]
  following        Follow[]             @relation("FollowFollower")
  followers        Follow[]             @relation("FollowFollowee")
  activities       Activity[]           @relation("ActivityActor")
  targetedBy       Activity[]           @relation("ActivityTargetUser")
  refreshTokens    RefreshToken[]
  sentMessages     Message[]            @relation("MessageSender")
  conversations    ConversationMember[]
  createdGroups    Conversation[]       @relation("ConversationCreator")
  uploads          Upload[]
  commentReactions CommentReaction[]
  emailTokens      EmailToken[]
  postMentions     PostMention[]
  commentMentions  CommentMention[]
  notifications    Notification[]       @relation("NotificationRecipient")
  notificationsSent Notification[]      @relation("NotificationActor")
  bookmarks        Bookmark[]

  @@map("users")
}

enum EmailTokenKind {
  verify_email
  password_reset

  @@map("email_token_kind")
}

/// Single-use links we mail. Only the SHA-256 of the token is stored, like refresh tokens.
model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  kind      EmailTokenKind
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("email_tokens")
}

model Post {
  id        String    @id @default(uuid(7)) @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  content   String
  imageKey  String?   @map("image_key")
  /// Null until the first edit; previous texts live in post_revisions.
  editedAt  DateTime? @map("edited_at") @db.Timestamptz(3)
  /// Generated by Postgres from `content` (migration `post_search`, ADR 0014). The `dbgenerated`
  /// default is how Prisma introspects a generated column; it only keeps the drift check quiet.
  /// Queried with raw SQL in `PostsService.search`.
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, content)")) @map("search_vector")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments      Comment[]
  likes         PostLike[]
  activities    Activity[]
  revisions     PostRevision[]
  mentions      PostMention[]
  hashtags      PostHashtag[]
  notifications Notification[]
  bookmarks     Bookmark[]

  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([searchVector], type: Gin)
  @@map("posts")
}

/// Members a post's text mentions (`@username`), resolved by the API when the post is saved or
/// edited and replaced as a whole on every edit. Stored by id so renames keep the link.
model PostMention {
  postId String @map("post_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_mentions")
}

/// Lower-cased tags of a post. `created_at` copies the post's so a tag page can keyset-paginate
/// without a join.
model PostHashtag {
  tag       String
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([tag, postId])
  @@index([tag, createdAt(sort: Desc), postId(sort: Desc)])
  @@index([createdAt])
  @@map("post_hashtags")
}

/// The text a post had before an edit replaced it (newest replacement first when listed).
model PostRevision {
  id       String   @id @default(uuid(7)) @db.Uuid
  postId   String   @map("post_id") @db.Uuid
  content  String
  editedAt DateTime @default(now()) @map("edited_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, editedAt(sort: Desc)])
  @@map("post_revisions")
}

model PostLike {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_likes")
}

/// A member's private "save for later" (C3a): no count on the post, no event, nobody else sees it.
model Bookmark {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt(sort: Desc), postId(sort: Desc)])
  @@map("bookmarks")
}

model Comment {
  id             String    @id @default(uuid(7)) @db.Uuid
  postId         String    @map("post_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  content        String
  /// Null until the first edit; previous texts live in comment_revisions.
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(3)
  /// Denormalised total of comment_reactions, kept in step by CommentsService (sorting by "top").
  reactionsCount Int       @default(0) @map("reactions_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  post          Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  activities    Activity[]
  revisions     CommentRevision[]
  reactions     CommentReaction[]
  mentions      CommentMention[]
  notifications Notification[]

  @@index([postId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([postId, reactionsCount(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@map("comments")
}

/// Members a comment's text mentions; same rules as `PostMention`.
model CommentMention {
  commentId String @map("comment_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_mentions")
}

model CommentRevision {
  id        String   @id @default(uuid(7)) @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  content   String
  editedAt  DateTime @default(now()) @map("edited_at") @db.Timestamptz(3)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId, editedAt(sort: Desc)])
  @@map("comment_revisions")
}

enum ReactionType {
  LIKE
  LOVE
  LAUGH
  WOW
  SAD

  @@map("reaction_type")
}

/// One reaction per member and comment; changing the emoji updates the row.
model CommentReaction {
  commentId String       @map("comment_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([commentId, type])
  @@map("comment_reactions")
}

enum UploadKind {
  avatar
  cover
  post
  message

  @@map("upload_kind")
}

/// Every stored file and who uploaded it. Only the owner may attach a key to
/// their profile or posts; files are deleted when nothing references them.
model Upload {
  key       String     @id
  ownerId   String     @map("owner_id") @db.Uuid
  kind      UploadKind
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([createdAt])
  @@map("uploads")
}

/// follower_id <> followee_id is enforced by a CHECK constraint added by hand
/// in the initial migration (Prisma has no schema syntax for it) and in the service.
model Follow {
  followerId String   @map("follower_id") @db.Uuid
  followeeId String   @map("followee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  follower User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("FollowFollowee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId, createdAt(sort: Desc), followerId(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc), followeeId(sort: Desc)])
  @@map("follows")
}

enum ActivityType {
  POST_CREATED
  COMMENT_CREATED
  POST_LIKED
  USER_FOLLOWED
  PROFILE_UPDATED
  USER_REGISTERED

  @@map("activity_type")
}

/// Written by the API in response to domain events, never by clients.
/// Subject columns are nullable because each type uses a different one.
model Activity {
  id           String       @id @default(uuid(7)) @db.Uuid
  actorId      String       @map("actor_id") @db.Uuid
  type         ActivityType
  postId       String?      @map("post_id") @db.Uuid
  commentId    String?      @map("comment_id") @db.Uuid
  targetUserId String?      @map("target_user_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  actor      User     @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  targetUser User?    @relation("ActivityTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("activities")
}

enum NotificationType {
  POST_LIKED
  POST_COMMENTED
  COMMENT_REACTED
  USER_FOLLOWED
  MENTIONED_IN_POST
  MENTIONED_IN_COMMENT

  @@map("notification_type")
}

/// What happened to a member's own things (ADR 0015). Written by NotificationsListener from
/// domain events, never by clients; one row per (recipient, type, actor, post, comment), so a
/// repeated event refreshes the row instead of adding one. `post_id` is set for every type
/// but a follow, so the unique key has no nulls to worry about there.
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  actorId   String           @map("actor_id") @db.Uuid
  postId    String?          @map("post_id") @db.Uuid
  commentId String?          @map("comment_id") @db.Uuid
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, type, actorId, postId, commentId])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum ConversationKind {
  direct
  group

  @@map("conversation_kind")
}

enum ConversationRole {
  admin
  member

  @@map("conversation_role")
}

enum MessageKind {
  user
  system

  @@map("message_kind")
}

/// A direct conversation is the single thread between two people; a group has a title and members.
model Conversation {
  id            String           @id @default(uuid(7)) @db.Uuid
  kind          ConversationKind
  title         String?
  createdById   String?          @map("created_by_id") @db.Uuid
  /// `<smaller user id>:<larger user id>` for direct conversations, so a pair has exactly one.
  directKey     String?          @unique @map("direct_key")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Denormalised from the newest message so the list can be ordered without a join.
  lastMessageAt DateTime?        @map("last_message_at") @db.Timestamptz(3)

  createdBy User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ConversationMember[]
  messages  Message[]

  @@index([lastMessageAt, createdAt])
  @@map("conversations")
}

/// Read state is per member: everything created up to `lastReadAt` has been seen.
model ConversationMember {
  conversationId String           @map("conversation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  /// Group admins rename, remove members and hand the role on; the creator starts as one.
  role           ConversationRole @default(member)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  lastReadAt     DateTime?        @map("last_read_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String      @id @default(uuid(7)) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  /// For a system line: who caused it.
  senderId       String      @map("sender_id") @db.Uuid
  /// `system` lines are written by the server about membership changes and renames.
  kind           MessageKind @default(user)
  /// Empty when the message is a picture only, a system line or deleted.
  content        String
  imageKey       String?     @map("image_key")
  /// Soft delete by the sender: the row stays for ordering and read marks, content and picture go.
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)
  /// The subject of a system line (shared `systemLineSchema`).
  systemMeta     Json?       @map("system_meta") @db.JsonB
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@map("messages")
}
