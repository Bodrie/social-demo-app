NODE_ENV=development
PORT=3000
# Local docker compose database (see /docker-compose.yml, host port 5433)
DATABASE_URL=postgresql://mesh:mesh@localhost:5433/mesh
# Integration tests start their own Postgres via Testcontainers. Set this only
# to point them at an existing database instead (CI does). Never your dev DB.
# TEST_DATABASE_URL=postgresql://mesh:mesh@localhost:5433/mesh_test

# Platform
LOG_LEVEL=debug                      # fatal|error|warn|info|debug|trace|silent
WEB_ORIGINS=http://localhost:5173    # comma-separated browser origins allowed by CORS
TRUST_PROXY=false                    # true behind Caddy/Cloudflare
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Auth
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters   # openssl rand -base64 48
JWT_ACCESS_TTL_SECONDS=900          # access token lifetime (15 min)
REFRESH_TTL_SECONDS=604800          # refresh token lifetime (7 days)
# COOKIE_SECURE=true                # defaults to true in production, false otherwise

# Public base URL for uploaded files (served by the API in phase 3c)
PUBLIC_ASSETS_URL=http://localhost:3000/api/v1/uploads
