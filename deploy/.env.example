# Copy to `.env` next to docker-compose.yml on the server. Never commit the real file.

# Image tag to run (a release tag such as v2.0.0, or latest). Rollback = pin the previous tag.
TAG=latest

# Public address of the app as seen by browsers (scheme + host, no trailing slash).
PUBLIC_URL=https://the-mesh.example.com

# Database (only reachable inside the compose network).
POSTGRES_USER=mesh
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=mesh

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Cloudflare Tunnel token (Zero Trust dashboard → Networks → Tunnels → your tunnel).
# Start with `docker compose --profile tunnel up -d` once it is set.
TUNNEL_TOKEN=

# Optional
LOG_LEVEL=info
WEB_PORT=8080
