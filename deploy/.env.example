# Copy to `.env` next to docker-compose.yml on the server. Never commit the real file.

# Image tag to run (a release tag such as v2.0.0, or latest). Rollback = pin the previous tag.
TAG=latest

# Public address of the app as seen by browsers (scheme + host, no trailing slash). Exactly one
# host: it becomes the CORS/Origin allow-list and the uploads URL. No aliases (www, apex).
PUBLIC_URL=https://social.bodrie.dev

# Database (only reachable inside the compose network).
POSTGRES_USER=mesh
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=mesh

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Outbound email (Resend over SMTP submission; see docs/RUNBOOK.md §2.6). The From address must
# belong to the domain verified at Resend.
SMTP_URL=smtps://resend:re_xxxxxxxxxxxxxxxx@smtp.resend.com:465
EMAIL_FROM="The Mesh <noreply@social.bodrie.dev>"

# Images come from GHCR by default; override to run a fork or a locally built image.
# API_IMAGE=ghcr.io/bodrie/the-mesh-api
# WEB_IMAGE=ghcr.io/bodrie/the-mesh-web

# Bot check on registration: the Cloudflare Turnstile secret of the widget whose site key was built
# into the web image (docs/RUNBOOK.md §2.7). The API refuses to start without it unless CAPTCHA=off.
TURNSTILE_SECRET=0x4AAAAAAA_xxxxxxxxxxxxxxxxxxxxxxxxx
# CAPTCHA=off

# Cloudflare Tunnel token (Zero Trust dashboard → Networks → Tunnels → your tunnel).
# Start with `docker compose --profile tunnel up -d` once it is set.
TUNNEL_TOKEN=

# Optional
LOG_LEVEL=info
WEB_PORT=8080
# The API runs the daily housekeeping (04:00 UTC: expired tokens, abandoned uploads, unconfirmed
# accounts). Only with several API containers: set it to false on all but one.
# JOBS_ENABLED=false
