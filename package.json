{
  "name": "the-mesh",
  "version": "2.0.0-dev",
  "private": true,
  "description": "The Mesh \u2013 social network demo app (monorepo)",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @the-mesh/api db:generate",
    "db:migrate": "pnpm --filter @the-mesh/api db:migrate",
    "db:deploy": "pnpm --filter @the-mesh/api db:deploy",
    "db:seed": "pnpm --filter @the-mesh/api db:seed",
    "db:studio": "pnpm --filter @the-mesh/api db:studio",
    "db:check": "pnpm --filter @the-mesh/api db:check"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
