{
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "no-console": "warn",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "**/*.scss", "reflect-metadata", "@testing-library/jest-dom/vitest"]
      }
    ]
  },
  "ignorePatterns": ["dist", "coverage", "node_modules"]
}
